# Copy to .env for local development (never commit real secrets)

PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/growthcloud
AUTH_TOKEN_SECRET=change-me-locally
APP_BASE_URL=http://localhost:3000
# Dashboard origins only. Customer shops calling /api/v1/sdk do not need to be listed.
CORS_ORIGIN=http://localhost:3000

# Optional email delivery for invites / password reset
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Growth Cloud <onboarding@yourdomain.com>
# RESEND_API_KEY=re_xxx

# Optional AI assistant
# GROQ_API_KEY=gsk_xxx
