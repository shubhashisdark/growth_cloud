generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  super_admin
  admin
  marketer
  developer
  sales
  viewer
}

enum UserStatus {
  pending_verification
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum VerificationTokenType {
  email_verification
  password_reset
  refresh_session
}

enum ApiKeyType {
  public
  secret
}

enum ApiKeyStatus {
  active
  revoked
  deleted
}

enum LeadStatus {
  active
  archived
}

enum LifecycleStage {
  subscriber
  lead
  mql
  sql
  customer
}

enum SegmentType {
  dynamic
  static
}

enum SegmentStatus {
  active
  paused
  archived
}

enum WorkflowStatus {
  active
  paused
  archived
}

enum WorkflowRunStatus {
  running
  completed
  failed
  cancelled
}

enum ScoringRuleType {
  positive
  negative
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  paused
  cancelled
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id                  String                @id
  name                String
  email               String                @unique
  passwordHash        String
  status              UserStatus            @default(pending_verification)
  emailVerifiedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  memberships         WorkspaceMember[]
  ownedWorkspaces     Workspace[]           @relation("WorkspaceOwner")
  passwordResets      PasswordResetToken[]
  sessions            Session[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  verificationTokens  VerificationToken[]
  invitationsSent     WorkspaceInvitation[] @relation("InvitationInviter")
  invitationsAccepted WorkspaceInvitation[] @relation("InvitationAcceptedBy")
  apiKeysCreated      ApiKey[]              @relation("ApiKeyCreatedBy")
  apiKeysUpdated      ApiKey[]              @relation("ApiKeyUpdatedBy")
}

model Session {
  id          String    @id
  userId      String
  tokenHash   String    @unique
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id        String                @id
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id                String                @id
  name              String
  slug              String                @unique
  plan              String
  timezone          String
  status            String
  ownerId           String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  owner             User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  memberships       WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  apiKeys           ApiKey[]
  leads             Lead[]
  segments          Segment[]
  workflows         Workflow[]
  auditLogs         AuditLog[]
  leadTags          LeadTag[]
  leadAssignments   LeadAssignment[]
  leadNotes         LeadNote[]
  leadConsents      LeadConsent[]
  leadActivities    LeadActivity[]
  emailTemplates    EmailTemplate[]
  emailCampaigns    EmailCampaign[]
  emailSuppressions EmailSuppression[]
  scoringRules      ScoringRule[]
  webhookSubscriptions WebhookSubscription[]
}

enum WebhookSubscriptionStatus {
  active
  paused
  disabled
}

model WebhookSubscription {
  id          String                    @id
  workspaceId String
  name        String
  targetUrl   String
  secret      String
  eventsJson  String                    @default("[]")
  status      WebhookSubscriptionStatus @default(active)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id])
  deliveries  WebhookDeliveryLog[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model WebhookDeliveryLog {
  id             String              @id
  subscriptionId String
  event          String
  payloadJson    String
  statusCode     Int?
  responseBody   String?
  durationMs     Int?
  attempt        Int                 @default(1)
  status         String              @default("pending")
  errorMessage   String?
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([subscriptionId, status])
}

model WorkspaceMember {
  id          String        @id
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id           String           @id
  workspaceId  String
  inviterId    String
  email        String
  role         WorkspaceRole
  tokenHash    String           @unique
  status       InvitationStatus @default(pending)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  workspace    Workspace        @relation(fields: [workspaceId], references: [id])
  inviter      User             @relation("InvitationInviter", fields: [inviterId], references: [id])
  acceptedBy   User?            @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([workspaceId, email])
}

model AuditLog {
  id           String     @id
  workspaceId  String?
  actorId      String?
  action       String
  entityType   String
  entityId     String
  metadataJson String
  createdAt    DateTime   @default(now())
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])
  actor        User?      @relation("AuditActor", fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id            String       @id
  workspaceId   String
  name          String
  prefix        String       @unique
  keyHash       String
  type          ApiKeyType
  status        ApiKeyStatus
  scopesJson    String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  deletedAt     DateTime?
  usageCount    Int          @default(0)
  createdById   String?
  updatedById   String?
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  createdBy     User?        @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?        @relation("ApiKeyUpdatedBy", fields: [updatedById], references: [id])
  usageEvents   ApiKeyUsage[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model ApiKeyUsage {
  id             String   @id
  apiKeyId       String
  path           String
  method         String
  statusCode     Int
  responseTimeMs Int
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt])
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id                 String              @id
  workspaceId        String
  email              String
  firstName          String
  lastName           String
  company            String
  source             String
  status             LeadStatus
  score              Int
  scoreUpdatedAt     DateTime?
  lifecycleStage     LifecycleStage
  tagsJson           String              @default("[]")
  customFieldsJson   String              @default("{}")
  assignedToId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  activities         LeadActivity[]
  notes              LeadNote[]
  consents           LeadConsent[]
  assignments        LeadAssignment[]
  segmentMemberships SegmentMembership[]
  scoreHistory       ScoreHistory[]

  @@index([workspaceId])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, score])
}

model LeadTag {
  id          String    @id
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model LeadAssignment {
  id           String    @id
  leadId       String
  workspaceId  String
  assigneeId   String
  assigneeName String?
  createdAt    DateTime  @default(now())
  lead         Lead      @relation(fields: [leadId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([leadId, createdAt])
  @@index([workspaceId, assigneeId])
}

model LeadNote {
  id          String    @id
  leadId      String
  workspaceId String
  note        String
  author      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead      @relation(fields: [leadId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([leadId, createdAt])
}

model LeadConsent {
  id          String    @id
  leadId      String
  workspaceId String
  type        String
  granted     Boolean   @default(false)
  source      String?
  grantedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead      @relation(fields: [leadId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([leadId, type])
  @@index([leadId, type])
  @@index([workspaceId, type])
}

model LeadActivity {
  id           String    @id
  leadId       String
  workspaceId  String
  activityType String
  description  String
  metadataJson String    @default("{}")
  createdAt    DateTime  @default(now())
  lead         Lead      @relation(fields: [leadId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── Segmentation ────────────────────────────────────────────────────────────

model Segment {
  id             String              @id
  workspaceId    String
  name           String
  description    String?
  type           SegmentType
  status         SegmentStatus
  rulesJson      String
  memberCount    Int                 @default(0)
  lastComputedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  workspace      Workspace           @relation(fields: [workspaceId], references: [id])
  memberships    SegmentMembership[]

  @@index([workspaceId])
  @@index([workspaceId, type])
}

model SegmentMembership {
  id        String   @id
  segmentId String
  leadId    String
  addedAt   DateTime @default(now())
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([segmentId, leadId])
  @@index([segmentId])
  @@index([leadId])
}

// ─── Workflows ────────────────────────────────────────────────────────────────

model Workflow {
  id             String         @id
  workspaceId    String
  name           String
  description    String?
  status         WorkflowStatus
  triggerType    String
  stepCount      Int
  definitionJson String
  runCount       Int            @default(0)
  errorCount     Int            @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  runs           WorkflowRun[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model WorkflowRun {
  id           String            @id
  workflowId   String
  leadId       String?
  status       WorkflowRunStatus @default(running)
  triggerEvent String
  inputJson    String            @default("{}")
  errorMessage String?
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepLogs     WorkflowStepLog[]

  @@index([workflowId, startedAt])
  @@index([leadId])
}

model WorkflowStepLog {
  id           String      @id
  runId        String
  stepIndex    Int
  stepType     String
  status       String
  inputJson    String      @default("{}")
  outputJson   String      @default("{}")
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime    @default(now())
  run          WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, stepIndex])
}

// ─── Lead Scoring ─────────────────────────────────────────────────────────────

model ScoringRule {
  id            String          @id
  workspaceId   String
  name          String
  description   String?
  type          ScoringRuleType
  conditionJson String
  points        Int
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])
  scoreHistory  ScoreHistory[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, type])
}

model ScoreHistory {
  id          String       @id
  leadId      String
  ruleId      String?
  scoreBefore Int
  scoreAfter  Int
  delta       Int
  reason      String
  createdAt   DateTime     @default(now())
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rule        ScoringRule? @relation(fields: [ruleId], references: [id])

  @@index([leadId, createdAt])
}

// ─── Email ────────────────────────────────────────────────────────────────────

model EmailTemplate {
  id            String          @id
  workspaceId   String
  name          String
  subject       String
  htmlContent   String
  textContent   String
  variablesJson String          @default("[]")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id])
  campaigns     EmailCampaign[]

  @@index([workspaceId])
}

model EmailCampaign {
  id               String         @id
  workspaceId      String
  name             String
  subject          String
  fromName         String         @default("Growth Cloud")
  fromEmail        String?
  templateId       String?
  status           CampaignStatus @default(draft)
  scheduledAt      DateTime?
  sentAt           DateTime?
  totalRecipients  Int            @default(0)
  sentCount        Int            @default(0)
  openCount        Int            @default(0)
  clickCount       Int            @default(0)
  bounceCount      Int            @default(0)
  unsubscribeCount Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id])
  template         EmailTemplate? @relation(fields: [templateId], references: [id])
  jobs             EmailJob[]
  events           EmailEvent[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model EmailJob {
  id                 String        @id
  campaignId         String
  recipientEmail     String
  recipientName      String?
  status             String        @default("queued")
  messageId          String?
  attemptedProviders String        @default("[]")
  sentAt             DateTime?
  openCount          Int           @default(0)
  clickCount         Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  campaign           EmailCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([recipientEmail])
}

model EmailEvent {
  id             String        @id
  campaignId     String
  recipientEmail String
  eventType      String
  url            String?
  ipAddress      String?
  userAgent      String?
  metadataJson   String        @default("{}")
  createdAt      DateTime      @default(now())
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, eventType])
  @@index([recipientEmail])
}

model EmailSuppression {
  id          String    @id
  workspaceId String
  email       String
  reason      String    @default("unsubscribe")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, email])
  @@index([workspaceId])
}
