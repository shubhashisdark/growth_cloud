{
  "name": "@shubhashis9556/growthcloud-sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for Growth Cloud marketing automation, lead tracking, and analytics",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsc && node --test dist/index.test.js"
  },
  "keywords": [
    "growth-cloud",
    "marketing-automation",
    "analytics",
    "lead-tracking",
    "sdk"
  ],
  "author": "Growth Cloud Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
